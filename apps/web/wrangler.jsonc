{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gamecoach-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_als"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  // F09: magic links carry their token in the URL fragment now (never sent to the server), but
  // this still guards any query string that does reach a request/trace against being retained.
  "observability": { "enabled": true, "redact_query_string": true },

  // Custom Domain: Cloudflare creates the proxied DNS record and certificate. gamecoach-session
  // has a Route on /ws/* for the same hostname, and Routes run before a Custom Domain.
  "routes": [{ "pattern": "chess.terminal-games.com", "custom_domain": true }],

  "vars": {
    "APP_ORIGIN": "https://chess.terminal-games.com",
    "EMAIL_FROM": "coach@chess.terminal-games.com"
  },
  // Secret: SESSION_SECRET (shared with gamecoach-session). Local: .dev.vars

  "services": [
    { "binding": "SESSION", "service": "gamecoach-session", "entrypoint": "SessionEntrypoint" }
  ],
  // F03: edge/IP admission control in front of the two endpoints that mint a guest identity
  // (POST /auth/request, POST /api/games), ahead of any D1 write they do. Best-effort/eventually
  // consistent per Cloudflare's docs -- a backstop, not the only control (see
  // src/lib/server/players.ts's per-email/per-guest counters for the rest).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamecoach",
      "database_id": "fe91350a-668b-4e4c-9f77-29cf68e5a9d9",
      "migrations_dir": "../../db/migrations"
    }
  ],
  // Cloudflare Email Sending (beta). chess.terminal-games.com is the onboarded sending
  // domain (2026-09-18), so EMAIL_FROM must be an address on that subdomain.
  "send_email": [{ "name": "EMAIL", "remote": true }]
}
