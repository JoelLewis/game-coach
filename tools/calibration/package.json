{
  "name": "@game-coach/calibration",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": { "./score/*": "./score/*.ts", "./labeler/*": "./labeler/*.ts" },
  "scripts": {
    "typecheck": "tsc -p score/tsconfig.json && svelte-check --tsconfig labeler/tsconfig.json",
    "test": "vitest run score && vitest run --config labeler/vitest.config.ts && vitest run --config labeler/vitest.ui.config.ts",
    "score": "node --experimental-strip-types score/run.ts",
    "label": "vite build --config labeler/vite.config.ts && node --experimental-strip-types labeler/server.ts"
  },
  "dependencies": {
    "@game-coach/contracts": "workspace:*",
    "@lichess-org/chessground": "^9.1.1",
    "svelte": "^5.57.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
