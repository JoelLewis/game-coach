{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "src/**/*.ts", "src/**/*.svelte"],
  "exclude": ["dist", "node_modules", "vite.config.ts", "vitest.config.ts", "vitest.ui.config.ts"]
}
